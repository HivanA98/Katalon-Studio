<?xml version="1.0" encoding="UTF-8"?>
<GlobalVariableEntities>
   <description></description>
   <name>default</name>
   <tag></tag>
   <defaultProfile>true</defaultProfile>
   <GlobalVariableEntity>
      <description></description>
      <initValue>'https://reqres.in'</initValue>
      <name>baseUrl</name>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description></description>
      <initValue>200</initValue>
      <name>successCode</name>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description></description>
      <initValue>3</initValue>
      <name>id</name>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>ReqRes x-api-key header; override in CI with -g_apiKey=...</description>
      <initValue>'reqres-free-v1'</initValue>
      <name>apiKey</name>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>Response time budget in milliseconds</description>
      <initValue>8000</initValue>
      <name>maxResponseMs</name>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>Default wait in seconds (shared core)</description>
      <initValue>15</initValue>
      <name>timeout</name>
   </GlobalVariableEntity>
</GlobalVariableEntities>
